# ─── WhatsApp Cloud API (from Meta Developer Dashboard) ───
WHATSAPP_TOKEN=EAAxxxxxxxxx...your_permanent_token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=analyxx_webhook_verify_2026

# ─── Your existing ANALYXX backend ───
BACKEND_URL=https://your-backend.onrender.com

# ─── Supabase (same keys as your backend/.env) ───
SUPABASE_URL=https://uxnesngjfduazyznpopx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ─── Groq AI (same key as your backend/.env) ───
GROQ_API_KEY=gsk_your_groq_api_key

# ─── Frontend URL (for redirecting users to website analysis page) ───
FRONTEND_URL=https://your-frontend-domain.com

# ─── Server ───
PORT=3001
NODE_ENV=production
