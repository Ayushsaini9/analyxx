# ── ANALYXX AI Backend — Production Environment Template ─────────────────────
# Copy this file to .env on your deployment server and fill in the values.
# Set these as environment variables in Render / Railway dashboard.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

SECRET_KEY=<generate_a_secure_random_64_char_hex_string>

# ── CORS — must include your production frontend URL ──
CORS_ALLOWED_ORIGINS=https://analyxx.com,https://www.analyxx.com

# ── Supabase ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=<supabase_anon_key>
SUPABASE_SERVICE_KEY=<supabase_service_role_key>
DATABASE_URL=postgresql://postgres.<project-id>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# ── Google OAuth ──
GOOGLE_CLIENT_ID=<your_google_client_id>.apps.googleusercontent.com

# ── AI Providers (Multi-Model Consensus) ──
# At minimum, configure GROQ_API_KEY. Add more for better AI answers.
GROQ_API_KEY=<your_groq_api_key>
GEMINI_API_KEY=<your_google_gemini_api_key>
OPENAI_API_KEY=<your_openai_api_key>
ANTHROPIC_API_KEY=<your_anthropic_api_key>
MISTRAL_API_KEY=<your_mistral_api_key>

# ── SMTP ──
SMTP_EMAIL=<your_smtp_email>
SMTP_PASSWORD=<your_app_password>

# ── WhatsApp Cloud API ──
WHATSAPP_TOKEN=<your_whatsapp_permanent_token>
WHATSAPP_PHONE_NUMBER_ID=<your_phone_number_id>
WHATSAPP_VERIFY_TOKEN=analyxx_webhook_verify_2026

# ── Razorpay (use rzp_live_ keys in production) ──
RAZORPAY_KEY_ID=rzp_live_<your_key_id>
RAZORPAY_KEY_SECRET=<your_key_secret>
RAZORPAY_WEBHOOK_SECRET=<your_webhook_secret>
RAZORPAY_PLAN_MONTHLY=plan_<monthly_plan_id>
RAZORPAY_PLAN_ANNUAL=plan_<annual_plan_id>

# ── Cloudflare R2 (PDF Storage) ──
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-r2-access-key>
R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
R2_BUCKET_NAME=analyxx-papers
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

